# SAPO - variables de entorno (copiar a .env)
SAPO_APP_NAME=SAPO API
SAPO_DEBUG=false
SAPO_DATA_DIR=data

# JSON que publica el modelo YOLO (el mismo que consume la web visual)
SAPO_DETECTIONS_FILE=data/live/detecciones.json

# Registro de cámaras (firewall IoT): se llena en runtime con POST /api/cameras
SAPO_CAMERA_REGISTRY=data/live/camaras.json
SAPO_DEVICE_FIREWALL=true

# Modelo YOLO (Modelo_Entrenado): publica JSON y opcionalmente hace POST a la API
SAPO_MODEL_API_URL=http://localhost:8000
SAPO_MODEL_TOKEN=cambiar-token-modelo

# Token que usan las cámaras IoT al hacer push
SAPO_INGEST_TOKEN=cambiar-token-ingest

# Límites operativos
SAPO_MAX_CAMERAS=200
SAPO_MAX_REQUESTS_PER_MINUTE=120
SAPO_DETECTION_TTL_HOURS=48

# Destinatarios de alertas (EAAB / IDIGER / Movilidad / aseo)
SAPO_ALERT_TARGETS=EAAB,IDIGER,MOVILIDAD,ASEO
